---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="不同步实验" description="让一个点立刻跟随，另一个点稍晚抵达，看看变化如何从间隙里出现。">
	<section class="lag-page">
		<p class="eyebrow">WORK 002 / A SMALL DELAY</p>
		<h1>不同步实验</h1>
		<p class="lag-page__intro">一个点立刻跟着你走，另一个点故意慢半拍。它们之间的空隙，就是这件小东西留下的唯一记录。</p>
		<div class="lag-stage" data-lag-stage tabindex="0" role="application" aria-label="不同步实验。移动指针或使用方向键，让两个点在场地中移动。">
			<div class="lag-stage__grid" aria-hidden="true"></div>
			<div class="lag-dot lag-dot--now" data-lag-now aria-hidden="true"></div>
			<div class="lag-dot lag-dot--later" data-lag-later aria-hidden="true"></div>
			<p class="lag-stage__hint">移动指针，或使用方向键</p>
		</div>
		<p class="lag-note">没有轨迹，没有分数，也没有保存。这里只保留一个瞬间和它稍后留下的偏差。</p>
		<p><a class="text-link" href="/">回到正在生长的路径 <span aria-hidden="true">↗</span></a></p>
	</section>
</BaseLayout>

<script is:inline>
	const stage = document.querySelector('[data-lag-stage]');
	const nowDot = document.querySelector('[data-lag-now]');
	const laterDot = document.querySelector('[data-lag-later]');
	const hint = stage?.querySelector('.lag-stage__hint');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	if (stage && nowDot && laterDot) {
		const target = { x: 0.5, y: 0.5 };
		const current = { x: 0.5, y: 0.5 };
		let hasMoved = false;
		const paint = () => {
			current.x += (target.x - current.x) * (reducedMotion.matches ? 1 : 0.055);
			current.y += (target.y - current.y) * (reducedMotion.matches ? 1 : 0.055);
			nowDot.style.left = `${target.x * 100}%`;
			nowDot.style.top = `${target.y * 100}%`;
			laterDot.style.left = `${current.x * 100}%`;
			laterDot.style.top = `${current.y * 100}%`;
			requestAnimationFrame(paint);
		};
		const moveTo = (x, y) => {
			target.x = Math.min(0.94, Math.max(0.06, x));
			target.y = Math.min(0.9, Math.max(0.1, y));
			if (!hasMoved && hint) {
				hasMoved = true;
				hint.textContent = '间隙正在出现';
			}
		};
		stage.addEventListener('pointermove', (event) => {
			const rect = stage.getBoundingClientRect();
			moveTo((event.clientX - rect.left) / rect.width, (event.clientY - rect.top) / rect.height);
		});
		stage.addEventListener('keydown', (event) => {
			const step = event.shiftKey ? 0.08 : 0.03;
			const offsets = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
			const offset = offsets[event.key];
			if (!offset) return;
			event.preventDefault();
			moveTo(target.x + offset[0], target.y + offset[1]);
		});
		paint();
	}
</script>

<style>
	.lag-page { padding: clamp(5rem, 10vw, 9rem) 0; }
	.lag-page h1 { max-width: 900px; margin: .18em 0 .3em; font-size: clamp(3.2rem, 8vw, 6.4rem); }
	.lag-page__intro { max-width: 620px; color: var(--moss); font-family: var(--display); font-size: clamp(1.12rem, 2.1vw, 1.5rem); }
	.lag-stage { position: relative; min-height: min(62vw, 620px); margin: clamp(3rem, 7vw, 6rem) 0 1.4rem; overflow: hidden; border: 1px solid var(--line); background: var(--cold-white); cursor: crosshair; outline: none; }
	.lag-stage:focus-visible { outline: 2px solid var(--signal); outline-offset: 5px; }
	.lag-stage__grid { position: absolute; inset: 0; opacity: .65; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 12.5% 12.5%; }
	.lag-dot { position: absolute; width: clamp(1rem, 2vw, 1.55rem); aspect-ratio: 1; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; }
	.lag-dot--now { background: var(--signal); box-shadow: 0 0 0 9px color-mix(in srgb, var(--signal) 15%, transparent); }
	.lag-dot--later { background: var(--moss); box-shadow: 0 0 0 1px var(--cold-white), 0 0 0 4px var(--moss); }
	.lag-stage__hint { position: absolute; right: 1rem; bottom: .8rem; margin: 0; color: var(--moss); font-family: var(--mono); font-size: .7rem; }
	.lag-note { max-width: 600px; color: var(--moss); font-size: .9rem; }
	@media (max-width: 600px) { .lag-stage { min-height: 112vw; } }
	@media (prefers-reduced-motion: reduce) { .lag-dot--later { transition: none; } }
</style>
